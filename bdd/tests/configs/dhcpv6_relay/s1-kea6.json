{ "Dhcp6": {
  "interfaces-config": { "interfaces": [ "s0/2001:db8::10" ] },
  "lease-database": { "type": "memfile", "persist": false },
  "data-directory": "@DIR@",
  "server-id": { "type": "EN", "enterprise-id": 2495, "identifier": "0123456789", "persist": false },
  "valid-lifetime": 600,
  "client-classes": [
    { "name": "ifid-lan1", "test": "relay6[0].option[18].hex == 'lan1'" },
    { "name": "no-ifid", "test": "not (relay6[0].option[18].hex == 'lan1')" }
  ],
  "subnet6": [
    { "id": 1, "subnet": "2001:db8:1::/64",
      "pools": [
        { "pool": "2001:db8:1::50 - 2001:db8:1::5f", "client-class": "ifid-lan1" },
        { "pool": "2001:db8:1::100 - 2001:db8:1::1ff", "client-class": "no-ifid" }
      ] }
  ],
  "loggers": [ { "name": "kea-dhcp6", "output_options": [ { "output": "stdout" } ], "severity": "INFO" } ]
} }
