{ "Dhcp4": {
  "interfaces-config": { "interfaces": [ "s0" ], "dhcp-socket-type": "udp" },
  "lease-database": { "type": "memfile", "persist": false },
  "valid-lifetime": 600,
  "client-classes": [
    { "name": "circuit-lan1", "test": "relay4[1].hex == 'lan1'" },
    { "name": "other-circuit", "test": "not (relay4[1].hex == 'lan1')" }
  ],
  "subnet4": [
    { "id": 1, "subnet": "10.1.0.0/24",
      "pools": [
        { "pool": "10.1.0.50 - 10.1.0.59", "client-class": "circuit-lan1" },
        { "pool": "10.1.0.100 - 10.1.0.199", "client-class": "other-circuit" }
      ],
      "option-data": [ { "name": "routers", "data": "10.1.0.1" } ] },
    { "id": 2, "subnet": "10.2.0.0/24",
      "pools": [ { "pool": "10.2.0.100 - 10.2.0.199" } ],
      "option-data": [ { "name": "routers", "data": "10.2.0.1" } ] }
  ],
  "loggers": [ { "name": "kea-dhcp4", "output_options": [ { "output": "stdout" } ], "severity": "INFO" } ]
} }
