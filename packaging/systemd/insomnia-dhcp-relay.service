[Unit]
Description=DHCP relay agent, driven by insomnia
# insomnia renders /run/insomnia/dhcp-relay/relay.json and starts, reloads
# or stops this unit through systemctl; the unit is never enabled on its
# own. One agent serves both families and every VRF.
After=network-online.target insomnia.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/insomnia-dhcp-relay \
    --config /run/insomnia/dhcp-relay/relay.json \
    --control /run/insomnia-dhcp-relay/control
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure

# The agent parses packets from every client on every listen interface,
# so it runs unprivileged and confined (design/dhcp.md §10.1, §12).
DynamicUser=yes
# Holds the control socket insomnia queries for `show dhcp relay
# statistics`; owned by the dynamic user.
RuntimeDirectory=insomnia-dhcp-relay
# Ports 67 and 547; SO_BINDTODEVICE and the AF_PACKET reply socket.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# Netlink for getifaddrs(3).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
