[Unit]
Description=Kea DHCPv4 server for VRF %i, driven by insomnia
# insomnia renders /run/insomnia/kea/%i/kea-dhcp4.conf, checks it with
# kea-dhcp4 -t and starts or stops this instance through systemctl; every
# later configuration is loaded over the control socket (config-test, then
# config-reload), never by restarting (design/dhcp.md §8). The instance
# name is the VRF; `default` serves the global table. The template is never
# enabled on its own.
After=network-online.target insomnia.service
Wants=network-online.target

[Service]
Type=simple
User=_kea
Group=_kea
# Kea's lock and pid files beside the configuration and control socket, in
# the directory insomnia creates (0770 root:_kea).
Environment=KEA_LOCKFILE_DIR=/run/insomnia/kea/%i
Environment=KEA_PIDFILE_DIR=/run/insomnia/kea/%i
ExecStart=/usr/sbin/kea-dhcp4 -c /run/insomnia/kea/%i/kea-dhcp4.conf
Restart=on-failure
# Leases (and the DHCPv6 server DUID), owned by _kea; they survive reboots
# and image updates.
StateDirectory=insomnia/kea/%i
StateDirectoryMode=0750

# Kea parses packets from every client on its listen interfaces (SBOM class
# E1), and Ubuntu has not backported the fixes for CVE-2025-32801/32802
# (hook loading and file writes through the control socket). So it runs as
# _kea, with two capabilities, under the sandbox (design/dhcp.md §8.3, §12).
# Port 67/547, and the raw DHCPv4 sockets.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/insomnia/kea/%i
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Lease files are 0640: they hold MAC addresses and host names.
UMask=0027
